# ─── App ───────────────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=change-this-to-a-long-random-string

# ─── Admin Account ─────────────────────────────────────────────────
ADMIN_EMAIL=joy@rawtalent.com.au
ADMIN_PASSWORD=YourSecurePasswordHere

# ─── Supabase (Postgres via session pooler + Storage) ──────────────
# From your Supabase project: Project Settings → Database → Connection
# string → "Session pooler" tab. Split into discrete fields (rather than
# one connection string) to avoid special characters in the password
# needing URL-encoding.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# From Project Settings → API. SERVICE_ROLE_KEY is used server-side only,
# for Supabase Storage (team photos, article attachments, call audio) —
# never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Google OAuth (optional but recommended) ───────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Google Drive (optional — for cloud backup of articles) ────────
# Base64-encoded service account JSON key
# Get from: Google Cloud → IAM → Service Accounts → Create Key → JSON
# Then run: base64 -i your-key.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY=

# The ID of the Google Drive folder where articles will be stored
# Share this folder with your service account email (Editor access)
DRIVE_FOLDER_ID=

# ─── Google Calendar (optional — Workforce Partner scheduling sync) ─
# Reuses GOOGLE_SERVICE_ACCOUNT_KEY above. That service account also needs
# domain-wide delegation authorized in the Workspace Admin console (Security
# → API controls → Domain-wide Delegation) for the calendar scope, and each
# partner below needs a rawtalent.com.au Workspace mailbox for delegation to
# work. CALENDAR_AUTH_MODE=oauth (per-partner consent, for partners without
# a Workspace account) is not implemented yet.
# CALENDAR_PARTNER_MAP is a JSON object mapping each partner's calendar
# email to the exact `assigned_workforce_partner` string used elsewhere in
# the app (see WORKFORCE_PARTNER_OPTIONS in public/admin.html):
#   {"gwen@rawtalent.com.au":"Gwen Stocks (SA)","justine@rawtalent.com.au":"Justine Hardware (VIC)","liam@rawtalent.com.au":"Liam Baxter"}
CALENDAR_AUTH_MODE=delegation
CALENDAR_PARTNER_MAP=

# ─── Webex (optional — Workforce Management / Agent Status) ────────
# Create a Service App at developer.webex.com with the spark-admin:people_read
# scope, authorize it in Control Hub (Management → Apps → Service Apps), then
# retrieve the token pair from that Service App's "Org Authorizations"
# section. WEBEX_REFRESH_TOKEN only seeds the app's own token store on first
# boot — after that the app manages refreshing/rotating it automatically.
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
WEBEX_REFRESH_TOKEN=

# ─── RawTalent Reports API (Clients/Candidates/Bookings/Timesheets) ─
# The locally-built RtApiReport service — no public docs, schema was
# reverse-engineered from its Swagger UI. Auth is a static X-API-Key
# header, not OAuth.
RT_API_BASE_URL=https://j8h9g2kg0i.execute-api.ap-southeast-2.amazonaws.com/RtApiReport
RT_API_KEY=
